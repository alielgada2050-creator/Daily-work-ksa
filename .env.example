# ===== وصلة عمل — نموذج الإعدادات. انسخه إلى .env ولا ترفع .env إلى GitHub =====
PORT=3000
NODE_ENV=development

# فارغ = قاعدة ذاكرة تجريبية (تُمسح عند الإيقاف). للتشغيل الفعلي:
# DATABASE_URL=postgres://wasla:CHANGE_ME@localhost:5432/wasla
DATABASE_URL=

# سر توقيع الجلسات والروابط المؤقتة — ولّده بـ: openssl rand -hex 32
SESSION_SECRET=

# true = دخول تجريبي + بيانات وهمية. اجعله false في الإنتاج.
DEMO_MODE=true

# ملفات تعريف الارتباط الآمنة تتطلب HTTPS. اجعلها false فقط للتجربة المحلية عبر http
COOKIE_SECURE=false

# ----- التخزين الخاص للملفات -----
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
SIGNED_URL_TTL_SEC=600
MAX_CV_MB=10
MAX_DOC_MB=5
API_RATE_LIMIT=600

# ----- التحقق OTP (mock يعرض الرمز في وضع التطوير فقط) -----
OTP_PROVIDER=mock

# ----- تحليل السير بالذكاء الاصطناعي: سلسلة مزودين مع تحويل تلقائي عند الفشل -----
# الترتيب يحدد الأولوية. الاستخراج المحلي (heuristic) يُضاف دائمًا في النهاية.
# مثال: AI_CHAIN=claude,9router,freellmapi,fcc   — اتركه فارغًا للاستخراج المحلي فقط
AI_CHAIN=
AI_TIMEOUT_MS=30000
# يخفي الجوال والبريد قبل الإرسال لأي مزود خارجي (يُستخرجان محليًا). اتركه true.
AI_REDACT_CONTACT=true

# Claude — واجهة Anthropic الرسمية (مدفوعة حسب الاستخدام) — console.anthropic.com
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_BASE_URL=https://api.anthropic.com

# 9Router — بوابة محلية: npm i -g 9router أو Docker، اللوحة على المنفذ 20128
NINEROUTER_URL=http://localhost:20128
NINEROUTER_KEY=
NINEROUTER_MODEL=               # من GET $NINEROUTER_URL/v1/models (يفضل combo)

# FreeLLMAPI — github.com/tashfeenahmed/freellmapi، اللوحة على المنفذ 3001
FREELLMAPI_URL=http://localhost:3001/v1
FREELLMAPI_KEY=                 # المفتاح الموحد من صفحة Keys
FREELLMAPI_MODEL=auto

# FCC (free-claude-code) — github.com/Alishahryar1/free-claude-code (AGPL v3)
FCC_URL=http://127.0.0.1:8082/v1
FCC_TOKEN=                      # فقط إن فعّلت Proxy Authentication
FCC_MODEL=                      # مثل nvidia_nim/nvidia/nemotron-3-ultra-550b-a55b

# أي واجهة أخرى متوافقة مع OpenAI (Gemini/Groq/OpenRouter/Ollama...) — أضف openai_compatible إلى AI_CHAIN
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=auto

# ----- OCR للسير الممسوحة (يتطلب: npm i tesseract.js) -----
OCR_PROVIDER=none

# ----- قنوات الإرسال (mock = محاكاة ويُعرض «محاكاة» في الواجهة) -----
# واتساب للأعمال (WhatsApp Cloud API): mock | cloud_api
WHATSAPP_PROVIDER=mock
WHATSAPP_TOKEN=                 # System User access token (دائم) من Meta Business
WHATSAPP_PHONE_ID=              # Phone number ID من WhatsApp Manager
WHATSAPP_APP_SECRET=            # App Secret للتحقق من توقيع الـWebhook
WHATSAPP_VERIFY_TOKEN=          # نص تختاره أنت ويُكتب نفسه في إعداد الـWebhook لدى Meta
WHATSAPP_API_BASE=https://graph.facebook.com/v21.0
WHATSAPP_TEMPLATE_LANG=ar
# أسماء القوالب المعتمدة لدى Meta (اتركها فارغة لمنع الإرسال بذلك القالب)
WHATSAPP_TEMPLATE_INVITE=
WHATSAPP_TEMPLATE_AVAILABILITY=
WHATSAPP_TEMPLATE_INTERVIEW=
WHATSAPP_TEMPLATE_MISSING_DOC=
WHATSAPP_TEMPLATE_START_CONFIRM=
SMS_PROVIDER=mock
EMAIL_PROVIDER=mock
TELEGRAM_PROVIDER=mock
TELEGRAM_BOT_TOKEN=
